{"config":{"lang":["ko","en"],"separator":"[\\s\\-]+","pipeline":[" "]},"docs":[{"location":"","title":"\uc5c5\ubb34\ubb38\uc11c \ubc30\ud3ec \uc2dc\uc2a4\ud15c","text":"<p>\ud300 \uc5c5\ubb34 \uc9c0\uc2dd, \uc6b4\uc601 \uc808\ucc28, \ud45c\uc900 \uc591\uc2dd, \ubcc0\uacbd \uc774\ub825\uc744 \ud55c\uacf3\uc5d0\uc11c \uac80\uc0c9\ud558\uace0 \ubc30\ud3ec\ud558\uae30 \uc704\ud55c \ubb38\uc11c \ud3ec\ud138\uc785\ub2c8\ub2e4.</p>"},{"location":"#_2","title":"\ubc14\ub85c\uac00\uae30","text":"<ul> <li>\ubb38\uc11c \uc791\uc131 \uaddc\uce59</li> <li>\ubc30\ud3ec \uc808\ucc28</li> <li>\uc5c5\ubb34 \ud504\ub85c\uc138\uc2a4</li> <li>\ud45c\uc900 \ud15c\ud50c\ub9bf</li> </ul>"},{"location":"#_3","title":"\uc6b4\uc601 \uc6d0\uce59","text":"<p>\ubb38\uc11c\ub294 \uc5c5\ubb34\uc758 \uc77c\ubd80\uc785\ub2c8\ub2e4</p> <p>\ubb38\uc11c\ub294 \uc644\ub8cc \ud6c4 \uc815\ub9ac\ud558\ub294 \uc0b0\ucd9c\ubb3c\uc774 \uc544\ub2c8\ub77c, \uc5c5\ubb34 \uc218\ud589 \uc911 \ud568\uaed8 \uad00\ub9ac\ub418\ub294 \uae30\uc900 \uc815\ubcf4\uc785\ub2c8\ub2e4.</p> <ul> <li>\ucd5c\uc2e0 \uc5c5\ubb34 \uae30\uc900\uc740 \uc774 \uc0ac\uc774\ud2b8\uc5d0 \uac8c\uc2dc\ub41c \ubb38\uc11c\ub97c \uc6b0\uc120\ud569\ub2c8\ub2e4.</li> <li>\ubcc0\uacbd \uc0ac\ud56d\uc740 Pull Request \ub610\ub294 \uac80\ud1a0 \uc808\ucc28\ub97c \ud1b5\ud574 \ubc18\uc601\ud569\ub2c8\ub2e4.</li> <li>\ubb38\uc11c\ub9c8\ub2e4 \ub2f4\ub2f9\uc790, \ucd5c\uc885 \uc218\uc815\uc77c, \uc801\uc6a9 \ubc94\uc704\ub97c \uba85\ud655\ud788 \ub0a8\uae41\ub2c8\ub2e4.</li> </ul>"},{"location":"#_4","title":"\uad8c\uc7a5 \ubb38\uc11c \ubd84\ub958","text":"\ubd84\ub958 \ubaa9\uc801 \uc608\uc2dc \uc2dc\uc791\ud558\uae30 \uc0ac\uc6a9\ubc95\uacfc \uc6b4\uc601 \ubc29\uc2dd \uc548\ub0b4 \uc791\uc131 \uaddc\uce59, \ubc30\ud3ec \uc808\ucc28 \uc5c5\ubb34 \ubb38\uc11c \uc2e4\uc81c \uc5c5\ubb34 \uc808\ucc28\uc640 \uae30\uc900 \ucc98\ub9ac \ud504\ub85c\uc138\uc2a4, \uccb4\ud06c\ub9ac\uc2a4\ud2b8 \ud45c\uc900 \ud15c\ud50c\ub9bf \ubc18\ubcf5 \ubb38\uc11c\uc758 \ud615\uc2dd \ud1b5\uc77c \ud68c\uc758\ub85d, \ub9e4\ub274\uc5bc, \ubcf4\uace0\uc11c \ubcc0\uacbd \uc774\ub825 \uc911\uc694\ud55c \ubcc0\uacbd\uc0ac\ud56d \ucd94\uc801 \ubc30\ud3ec \ub0b4\uc5ed, \uc6b4\uc601 \ubcc0\uacbd"},{"location":"changelog/","title":"\ubcc0\uacbd \uc774\ub825","text":"\ub0a0\uc9dc \ubcc0\uacbd \ub0b4\uc6a9 \ub2f4\ub2f9\uc790 2026-05-20 \uc5c5\ubb34\ubb38\uc11c \ubc30\ud3ec \uc2dc\uc2a4\ud15c \ucd08\uae30 \uad6c\uc131 Codex"},{"location":"document-templates/","title":"\ud45c\uc900 \ud15c\ud50c\ub9bf","text":"<p>\ubc18\ubcf5\uc801\uc73c\ub85c \uc791\uc131\ud558\ub294 \uc5c5\ubb34 \ubb38\uc11c\ub294 \ud15c\ud50c\ub9bf\uc744 \uc0ac\uc6a9\ud574 \ud615\uc2dd\uc744 \ud1b5\uc77c\ud569\ub2c8\ub2e4.</p>"},{"location":"document-templates/#_2","title":"\uc81c\uacf5 \ud15c\ud50c\ub9bf","text":"<ul> <li>\ud68c\uc758\ub85d</li> <li>\uc5c5\ubb34 \ub9e4\ub274\uc5bc</li> <li>\uc7a5\uc560 \ubcf4\uace0\uc11c</li> </ul>"},{"location":"document-templates/#_3","title":"\uc0ac\uc6a9 \ubc29\ubc95","text":"<ol> <li>\ud544\uc694\ud55c \ud15c\ud50c\ub9bf\uc744 \uc5fd\ub2c8\ub2e4.</li> <li>\uc0c8 \ubb38\uc11c\uc5d0 \uad6c\uc870\ub97c \ubcf5\uc0ac\ud569\ub2c8\ub2e4.</li> <li>\uc5c5\ubb34\uc5d0 \ub9de\uac8c \ud56d\ubaa9\uc744 \ucc44\uc6c1\ub2c8\ub2e4.</li> <li>\ubd88\ud544\uc694\ud55c \ud56d\ubaa9\uc740 \uc0ad\uc81c\ud558\uc9c0 \ub9d0\uace0 <code>\ud574\ub2f9 \uc5c6\uc74c</code>\uc73c\ub85c \ud45c\uc2dc\ud560\uc9c0 \uac80\ud1a0\ud569\ub2c8\ub2e4.</li> </ol>"},{"location":"document-templates/incident-report/","title":"\uc7a5\uc560 \ubcf4\uace0\uc11c \ud15c\ud50c\ub9bf","text":""},{"location":"document-templates/incident-report/#_2","title":"\uac1c\uc694","text":"\ud56d\ubaa9 \ub0b4\uc6a9 \uc7a5\uc560\uba85 \ubc1c\uc0dd \uc77c\uc2dc \ubcf5\uad6c \uc77c\uc2dc \uc601\ud5a5 \ubc94\uc704 \ub2f4\ub2f9\uc790"},{"location":"document-templates/incident-report/#_3","title":"\ud0c0\uc784\ub77c\uc778","text":"\uc2dc\uac04 \ub0b4\uc6a9 \ub2f4\ub2f9\uc790"},{"location":"document-templates/incident-report/#_4","title":"\uc6d0\uc778","text":""},{"location":"document-templates/incident-report/#_5","title":"\uc870\uce58 \ub0b4\uc6a9","text":""},{"location":"document-templates/incident-report/#_6","title":"\uc7ac\ubc1c \ubc29\uc9c0 \ub300\ucc45","text":"\ub300\ucc45 \ub2f4\ub2f9\uc790 \uae30\ud55c \uc0c1\ud0dc"},{"location":"document-templates/meeting-notes/","title":"\ud68c\uc758\ub85d \ud15c\ud50c\ub9bf","text":""},{"location":"document-templates/meeting-notes/#_2","title":"\ud68c\uc758 \uc815\ubcf4","text":"\ud56d\ubaa9 \ub0b4\uc6a9 \ud68c\uc758\uba85 \uc77c\uc2dc \ucc38\uc11d\uc790 \uc791\uc131\uc790"},{"location":"document-templates/meeting-notes/#_3","title":"\uc548\uac74","text":""},{"location":"document-templates/meeting-notes/#_4","title":"\ub17c\uc758 \ub0b4\uc6a9","text":"\uc548\uac74 \uc8fc\uc694 \ub0b4\uc6a9 \uacb0\uc815 \uc0ac\ud56d"},{"location":"document-templates/meeting-notes/#_5","title":"\uc561\uc158 \uc544\uc774\ud15c","text":"\ud560 \uc77c \ub2f4\ub2f9\uc790 \uae30\ud55c \uc0c1\ud0dc"},{"location":"document-templates/work-manual/","title":"\uc5c5\ubb34 \ub9e4\ub274\uc5bc \ud15c\ud50c\ub9bf","text":"<p>\uc0c1\ud0dc: \ub2f4\ub2f9\uc790: \ucd5c\uc885 \uc218\uc815\uc77c:</p>"},{"location":"document-templates/work-manual/#_2","title":"\ubaa9\uc801","text":""},{"location":"document-templates/work-manual/#_3","title":"\uc801\uc6a9 \ubc94\uc704","text":""},{"location":"document-templates/work-manual/#_4","title":"\uc0ac\uc804 \uc900\ube44","text":""},{"location":"document-templates/work-manual/#_5","title":"\uc808\ucc28","text":""},{"location":"document-templates/work-manual/#_6","title":"\uc608\uc678 \uc0c1\ud669","text":"\uc0c1\ud669 \ucc98\ub9ac \ubc29\ubc95 \ub2f4\ub2f9\uc790"},{"location":"document-templates/work-manual/#_7","title":"\uad00\ub828 \ubb38\uc11c","text":""},{"location":"getting-started/","title":"\uc2dc\uc791\ud558\uae30","text":"<p>\uc774 \uc601\uc5ed\uc740 \ubb38\uc11c \ud3ec\ud138\uc744 \uc0ac\uc6a9\ud558\ub294 \uc0ac\ub78c\uacfc \ubb38\uc11c\ub97c \uad00\ub9ac\ud558\ub294 \uc0ac\ub78c \ubaa8\ub450\ub97c \uc704\ud55c \uae30\ubcf8 \uc548\ub0b4\uc785\ub2c8\ub2e4.</p>"},{"location":"getting-started/#_2","title":"\uc0ac\uc6a9\uc790","text":"<ul> <li>\uc0c1\ub2e8 \uac80\uc0c9\ucc3d\uc5d0\uc11c \uc5c5\ubb34\uba85, \uc2dc\uc2a4\ud15c\uba85, \ud0a4\uc6cc\ub4dc\ub85c \ubb38\uc11c\ub97c \ucc3e\uc2b5\ub2c8\ub2e4.</li> <li>\uc67c\ucabd \uba54\ub274\uc5d0\uc11c \uad00\ub828 \uc5c5\ubb34 \uc601\uc5ed\uc744 \ud0d0\uc0c9\ud569\ub2c8\ub2e4.</li> <li>\ubb38\uc11c \uc0c1\ub2e8 \ub610\ub294 \ud558\ub2e8\uc758 \uc218\uc815 \ub9c1\ud06c\ub97c \ud1b5\ud574 \uac1c\uc120 \uc694\uccad\uc744 \ub0a8\uae41\ub2c8\ub2e4.</li> </ul>"},{"location":"getting-started/#_3","title":"\ubb38\uc11c \uad00\ub9ac\uc790","text":"<ul> <li>\uc0c8 \ubb38\uc11c\ub294 <code>docs/</code> \uc544\ub798 \uc801\uc808\ud55c \uc5c5\ubb34 \ud3f4\ub354\uc5d0 \ucd94\uac00\ud569\ub2c8\ub2e4.</li> <li>\uba54\ub274 \ub178\ucd9c\uc774 \ud544\uc694\ud55c \ubb38\uc11c\ub294 <code>mkdocs.yml</code>\uc758 <code>nav</code>\uc5d0 \ub4f1\ub85d\ud569\ub2c8\ub2e4.</li> <li>\ubc30\ud3ec \uc804 <code>mkdocs build</code>\ub85c \ub9c1\ud06c \uc624\ub958\uc640 \uc124\uc815 \uc624\ub958\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.</li> </ul>"},{"location":"getting-started/deployment/","title":"\ubc30\ud3ec \uc808\ucc28","text":""},{"location":"getting-started/deployment/#_2","title":"\ub85c\uceec \ud655\uc778","text":"<pre><code>.\\.venv\\Scripts\\mkdocs.exe serve --dev-addr 127.0.0.1:8000\n</code></pre> <p>\ub85c\uceec \uc8fc\uc18c\uc5d0\uc11c \ubb38\uc11c \uba54\ub274, \uac80\uc0c9, \ub9c1\ud06c\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.</p>"},{"location":"getting-started/deployment/#_3","title":"\uc815\uc801 \uc0ac\uc774\ud2b8 \ube4c\ub4dc","text":"<pre><code>.\\.venv\\Scripts\\mkdocs.exe build\n</code></pre> <p>\ube4c\ub4dc \uacb0\uacfc\ub294 <code>site/</code> \ud3f4\ub354\uc5d0 \uc0dd\uc131\ub429\ub2c8\ub2e4.</p>"},{"location":"getting-started/deployment/#github-pages","title":"GitHub Pages \uc790\ub3d9 \ubc30\ud3ec","text":"<p>\uc774 \uc800\uc7a5\uc18c\uc5d0\ub294 <code>.github/workflows/deploy.yml</code>\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. <code>main</code> \ube0c\ub79c\uce58\uc5d0 \ubcc0\uacbd\uc0ac\ud56d\uc774 \ubc18\uc601\ub418\uba74 GitHub Actions\uac00 \uc0ac\uc774\ud2b8\ub97c \ube4c\ub4dc\ud558\uace0 GitHub Pages\uc5d0 \ubc30\ud3ec\ud569\ub2c8\ub2e4.</p> <p>GitHub \uc800\uc7a5\uc18c \uc124\uc815\uc5d0\uc11c Pages \ubc30\ud3ec \uc18c\uc2a4\ub97c <code>GitHub Actions</code>\ub85c \uc9c0\uc815\ud574\uc57c \ud569\ub2c8\ub2e4.</p>"},{"location":"getting-started/deployment/#_4","title":"\uc218\ub3d9 \ubc30\ud3ec","text":"<p>\ud544\uc694\ud558\uba74 \uc544\ub798 \uba85\ub839\uc73c\ub85c <code>gh-pages</code> \ube0c\ub79c\uce58\uc5d0 \uc9c1\uc811 \ubc30\ud3ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> <pre><code>.\\.venv\\Scripts\\mkdocs.exe gh-deploy --force\n</code></pre>"},{"location":"getting-started/writing-guide/","title":"\ubb38\uc11c \uc791\uc131 \uaddc\uce59","text":""},{"location":"getting-started/writing-guide/#_2","title":"\uae30\ubcf8 \uad6c\uc870","text":"<p>\uc5c5\ubb34\ubb38\uc11c\ub294 \uac00\ub2a5\ud55c \ud55c \uc544\ub798 \uad6c\uc870\ub97c \ub530\ub985\ub2c8\ub2e4.</p> <pre><code># \ubb38\uc11c \uc81c\ubaa9\n\n## \ubaa9\uc801\n\n## \uc801\uc6a9 \ubc94\uc704\n\n## \ub2f4\ub2f9\uc790\n\n## \uc808\ucc28\n\n## \uc608\uc678 \ubc0f \uc8fc\uc758\uc0ac\ud56d\n\n## \ubcc0\uacbd \uc774\ub825\n</code></pre>"},{"location":"getting-started/writing-guide/#_3","title":"\uc791\uc131 \uc6d0\uce59","text":"<ul> <li>\uc81c\ubaa9\uc740 \uc0ac\uc6a9\uc790\uac00 \uac80\uc0c9\ud560 \ubc95\ud55c \uc5c5\ubb34\uba85\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</li> <li>\ud558\ub098\uc758 \ubb38\uc11c\ub294 \ud558\ub098\uc758 \ubaa9\uc801\uc744 \uac16\ub3c4\ub85d \ub098\ub215\ub2c8\ub2e4.</li> <li>\ub2f4\ub2f9\uc790, \ucd5c\uc885 \uc218\uc815\uc77c, \uc801\uc6a9 \ubc94\uc704\ub97c \ubb38\uc11c \uc55e\ubd80\ubd84\uc5d0 \uc801\uc2b5\ub2c8\ub2e4.</li> <li>\uc808\ucc28\ub294 \uc2e4\uc81c \uc218\ud589 \uc21c\uc11c\ub300\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</li> <li>\uc2a4\ud06c\ub9b0\uc0f7\uc774\ub098 \ud30c\uc77c\uba85\uc740 \uc2dc\uac04\uc774 \uc9c0\ub098\ub3c4 \uc774\ud574 \uac00\ub2a5\ud55c \uc124\uba85\uc744 \ubd99\uc785\ub2c8\ub2e4.</li> </ul>"},{"location":"getting-started/writing-guide/#_4","title":"\uc0c1\ud0dc \ud45c\uc2dc","text":"<p>\uad8c\uc7a5</p> <p>\uac80\ud1a0 \uc911\uc778 \ub0b4\uc6a9\uc740 \ubb38\uc11c \uc81c\ubaa9 \uc544\ub798\uc5d0 \uc0c1\ud0dc\uc640 \uac80\ud1a0\uc790\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4.</p> <p>\uc608\uc2dc:</p> <pre><code>\uc0c1\ud0dc: \uac80\ud1a0 \uc911\n\ub2f4\ub2f9\uc790: \uc6b4\uc601\ud300\n\ucd5c\uc885 \uc218\uc815\uc77c: 2026-05-20\n</code></pre>"},{"location":"operations/","title":"\uc5c5\ubb34 \ubb38\uc11c","text":"<p>\uc5c5\ubb34 \ubb38\uc11c\ub294 \uc2e4\uc81c \uc6b4\uc601 \uae30\uc900\uacfc \uc808\ucc28\ub97c \ub2f4\ub294 \uc601\uc5ed\uc785\ub2c8\ub2e4.</p>"},{"location":"operations/#_2","title":"\ubb38\uc11c \ubaa9\ub85d","text":"<ul> <li>\uc5c5\ubb34 \ud504\ub85c\uc138\uc2a4</li> <li>\uccb4\ud06c\ub9ac\uc2a4\ud2b8</li> </ul>"},{"location":"operations/#_3","title":"\ubb38\uc11c \ub4f1\ub85d \uae30\uc900","text":"<ul> <li>\ubc18\ubcf5\uc801\uc73c\ub85c \uc218\ud589\ub418\ub294 \uc5c5\ubb34</li> <li>\ub2f4\ub2f9\uc790 \ubcc0\uacbd \uc2dc \uc778\uc218\uc778\uacc4\uac00 \ud544\uc694\ud55c \uc5c5\ubb34</li> <li>\uc2b9\uc778, \uac80\ud1a0, \ubc30\ud3ec \uac19\uc740 \ud1b5\uc81c\uac00 \ud544\uc694\ud55c \uc5c5\ubb34</li> <li>\uc7a5\uc560\ub098 \uace0\uac1d \uc601\ud5a5\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc5c5\ubb34</li> </ul>"},{"location":"operations/checklist/","title":"\uccb4\ud06c\ub9ac\uc2a4\ud2b8","text":""},{"location":"operations/checklist/#_2","title":"\ubb38\uc11c \ubc30\ud3ec \uc804","text":"<ul> <li> \uc0c8 \ubb38\uc11c\uac00 \uc801\uc808\ud55c \ud3f4\ub354\uc5d0 \uc704\uce58\ud55c\ub2e4.</li> <li> <code>mkdocs.yml</code>\uc758 \uba54\ub274\uc5d0 \ud544\uc694\ud55c \ubb38\uc11c\uac00 \ub4f1\ub85d\ub418\uc5b4 \uc788\ub2e4.</li> <li> \ubb38\uc11c \uc81c\ubaa9\uacfc \ud30c\uc77c\uba85\uc774 \uc5c5\ubb34 \ub0b4\uc6a9\uc744 \uc124\uba85\ud55c\ub2e4.</li> <li> \ub0b4\ubd80 \ub9c1\ud06c\uac00 \uc815\uc0c1 \ub3d9\uc791\ud55c\ub2e4.</li> <li> \ub2f4\ub2f9\uc790\uc640 \ucd5c\uc885 \uc218\uc815\uc77c\uc774 \uc801\ud600 \uc788\ub2e4.</li> <li> <code>mkdocs build</code>\uac00 \uc624\ub958 \uc5c6\uc774 \uc644\ub8cc\ub41c\ub2e4.</li> </ul>"},{"location":"operations/checklist/#_3","title":"\uc6b4\uc601 \ubcc0\uacbd \uc804","text":"<ul> <li> \ubcc0\uacbd \ubaa9\uc801\uc774 \uba85\ud655\ud558\ub2e4.</li> <li> \uc601\ud5a5 \ubc94\uc704\uac00 \ud655\uc778\ub418\uc5c8\ub2e4.</li> <li> \uc2b9\uc778\uc790\uac00 \uc9c0\uc815\ub418\uc5c8\ub2e4.</li> <li> \ub864\ubc31 \ub610\ub294 \ubcf5\uad6c \uc808\ucc28\uac00 \uc900\ube44\ub418\uc5c8\ub2e4.</li> <li> \ubcc0\uacbd \ud6c4 \uacb0\uacfc\ub97c \uae30\ub85d\ud560 \uc704\uce58\uac00 \uc815\ud574\uc84c\ub2e4.</li> </ul>"},{"location":"operations/process/","title":"\uc5c5\ubb34 \ud504\ub85c\uc138\uc2a4","text":"<p>\uc0c1\ud0dc: \ucd08\uc548 \ub2f4\ub2f9\uc790: \ubb38\uc11c \uad00\ub9ac\uc790 \ucd5c\uc885 \uc218\uc815\uc77c: 2026-05-20</p>"},{"location":"operations/process/#_2","title":"\ubaa9\uc801","text":"<p>\uc5c5\ubb34 \ucc98\ub9ac \ud750\ub984\uc744 \ud45c\uc900\ud654\ud558\uc5ec \ub2f4\ub2f9\uc790 \uac04 \ud3b8\ucc28\ub97c \uc904\uc774\uace0 \uc774\ub825\uc744 \ub0a8\uae41\ub2c8\ub2e4.</p>"},{"location":"operations/process/#_3","title":"\uae30\ubcf8 \ud750\ub984","text":"<ol> <li>\uc694\uccad \uc811\uc218</li> <li>\ub2f4\ub2f9\uc790 \uc9c0\uc815</li> <li>\uc601\ud5a5 \ubc94\uc704 \ud655\uc778</li> <li>\uc791\uc5c5 \uc218\ud589</li> <li>\uac80\ud1a0 \ubc0f \uc2b9\uc778</li> <li>\uacb0\uacfc \uacf5\uc720</li> <li>\ubb38\uc11c \uc5c5\ub370\uc774\ud2b8</li> </ol>"},{"location":"operations/process/#_4","title":"\uae30\ub85d \ud56d\ubaa9","text":"\ud56d\ubaa9 \uc124\uba85 \uc694\uccad\uc790 \uc5c5\ubb34\ub97c \uc694\uccad\ud55c \uc0ac\ub78c \ub610\ub294 \uc870\uc9c1 \ub2f4\ub2f9\uc790 \uc2e4\uc81c \ucc98\ub9ac \ucc45\uc784\uc790 \ucc98\ub9ac\uc77c \uc791\uc5c5 \uc644\ub8cc\uc77c \uc601\ud5a5 \ubc94\uc704 \uc0ac\uc6a9\uc790, \uc2dc\uc2a4\ud15c, \ub370\uc774\ud130 \uc601\ud5a5 \uacb0\uacfc \uc644\ub8cc, \ubcf4\ub958, \ubc18\ub824 \ub4f1 \ucd5c\uc885 \uc0c1\ud0dc"}]}